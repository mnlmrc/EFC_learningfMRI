{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "searchlight encoding",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "searchlight_encoding_session",
                "--glm",
                "3",
                "--sns",
                "101",
                "102"
            ]
        },
        {
            "name": "component weights",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/component_model.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "args": ["--what", "weight"]
        },
        {
            "name": "behaviour",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/behaviour.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "make searchlight",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "make_searchlight",
                "--sns",
                "101"
            ]
        },
        {
            "name": "make_cifti",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "make_cifti_repetition_suppression",
                "--glm",
                "2",
                "--sns",
                "101"
            ]
        },
        {
            "name": "G_trained_untrained",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "G_trained_untrained",
                "--sns",
                "101", "102"
            ]
        },
        {
            "name": "make_cortical_rois",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "make_cortical_rois",
                "--sns",
                "111",
                "--glm", "3"
            ]
        }
    ]
}